# Local data and third-party clones
data/
third_party/
mit/bevfusion/

# Legacy OpenMMLab harness and results (local only)
archive/
results/
out*/
kernel/
interactive/
notebook-kernel/

# Agent-local state
.commandcode/

# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# PM profile data — không thuộc tài liệu dự án
.scratch/hermes-pm/

# graphify artifact (generated graph output)
graphify-out/

# Scratch measurement outputs — giữ script, không giữ dữ liệu sinh ra
.scratch/*/tmp/**/*.csv
.scratch/*/tmp/**/*.npy
.scratch/*/tmp/**/*.bag
.scratch/*/tmp/**/*.xlsx
.scratch/*/tmp/**/*.jsonl
.scratch/*/tmp/**/*.json
.scratch/*/tmp/**/*.png
.scratch/*/tmp/**/*.mp4
.scratch/*/tmp/**/*.txt
.scratch/*/tmp/bagprobe/
# NGOẠI LỆ: a3_targets_static.json là NGUỒN của bảng _CLUSTER_VISIBLE_BY_SPEED
# (spray/plume.py:23-60, ADR-0006 D2). 2 KB, không tái lập được nếu mất laptop.
!.scratch/roadspray-cal/tmp/a3_targets_static.json
.scratch/roadspray-fit/tmp/full_*.json

# Video/contact-sheet so sánh plume-vs-thật ở gốc .scratch/ (1–2 MB mỗi bản × 27 bản,
# là ảnh trung gian của scripts/visualize_plume_vs_real.py — sinh lại được)
.scratch/*.mp4
.scratch/*.png
.scratch/viz_frames/

# Build artifact cua Kaggle bundle (tao lai bang kaggle/gate_c/make_bundles.py)
kaggle/*/bundles/

# .scratch/diag/ — log + artifact chẩn đoán sinh ra trong phiên (1,3 GB, không tái lập được
# nhưng cũng không cần trong git). Giữ .gitkeep để thư mục tồn tại.
.scratch/diag/*
!.scratch/diag/.gitkeep

# Probe một lần trong .scratch/roadspray-cal/tmp — đã đóng góp vào doc/số đo, không
# còn nằm trên đường chạy. Giữ .py analysis/measure nếu còn tái dùng.
.scratch/roadspray-cal/tmp/probe_*.py
.scratch/roadspray-cal/tmp/*.log
.scratch/tmp/*.sh

# .scratch/tmp/ = sân nháp một lần (script đo + output JSON/TXT của các phiên A3/A3-V/D2/
# cổng C). Không nằm trên đường chạy, mọi kết luận đã chép vào docs/measurements/.
.scratch/tmp/

# Log ngắn hạn ở gốc .scratch/ (viz*.log) và output probe rời
.scratch/*.log
.scratch/roadspray-cal/tmp/*.out
